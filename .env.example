# Backend Configuration
DATABASE_URL=postgresql://postgres:password@database-host:5432/atlas
JWT_SECRET_KEY=change-this-to-a-secure-random-secret
JWT_EXPIRY_HOURS=24
PORT=8000
CORS_ORIGINS=*

# S3 / Object Storage Configuration
S3_BUCKET=nfolks-atlas-prod
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# S3_ENDPOINT_URL: Leave unset for AWS S3. For local MinIO, set to http://localhost:9000
S3_ENDPOINT_URL=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
